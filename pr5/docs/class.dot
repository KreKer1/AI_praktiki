digraph C {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.5, ranksep=0.8];
node [shape=record, style="filled", fontname="Liberation Serif", fontsize=12, color="#2F5597", fillcolor="#F7FBFF"];
edge [fontname="Liberation Serif", fontsize=10, color="#555555"];
a [label="{TimesheetAnalyzer\n(все члены static)|~ DAYS: int = 5\l~ MIN_HOURS: int = 0\l~ MAX_HOURS: int = 16\l~ DAILY_NORM: int = 8\l~ WEEKLY_NORM: int = 20\l|+ parseHours(line: String): int[]\l+ total(hours: int[]): int\l+ average(hours: int[]): double\l+ overtimeDays(hours: int[]): int\l+ weeklyOvertime(hours: int[]): int\l+ analyze(line: String): String\l+ main(args: String[]): void\l}"];
s [label="{SelfCheck\n(все члены static)|+ main(args: String[]): void\l- parses(line: String): boolean\l- errorContains(line: String, fragment: String): boolean\l- check(name: String, condition: boolean): int\l}"];
s -> a [style=dashed, arrowhead=vee, label="«use»"];
}
